# AutoGuard DMS Environment Configuration
# Copy this file to .env and adjust for your local deployment environment

# Platform selection: macos or raspberrypi
PLATFORM=macos

# Hardware power profile: LOW_POWER, BALANCED, HIGH_QUALITY, or MAC_DEVELOPMENT
POWER_PROFILE=BALANCED

# Camera device configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# ESP32-S3 Peripheral Controller
ESP32_ENABLED=false
ESP32_PORT=AUTO
ESP32_BAUD=115200

# Headless / GUI selection
QT_QPA_PLATFORM=offscreen
